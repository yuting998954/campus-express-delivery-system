
.page.data-v-5501f474 {
	display: flex;
	flex-direction: column;
	height: 100vh;
	background-color: #f0f2f5;
}

/* 顶部标题 */
/* .page-header {
	background: linear-gradient(135deg, #4f46e5, #7c3aed);
	padding: 40rpx 40rpx 40rpx;
} */
.page-title.data-v-5501f474 {
	display: block;
	font-size: 44rpx;
	font-weight: 700;
	color: #fff;
	letter-spacing: 2rpx;
}
.page-sub.data-v-5501f474 {
	display: block;
	font-size: 24rpx;
	color: rgba(255, 255, 255, 0.7);
	margin-top: 8rpx;
}

/* 筛选标签 */
.filter-tabs.data-v-5501f474 {
	display: flex;
	background-color: #fff;
	padding: 0 40rpx;
	border-bottom: 1rpx solid #eee;
}
.tab.data-v-5501f474 {
	position: relative;
	display: flex;
	align-items: center;
	gap: 8rpx;
	padding: 28rpx 0;
	margin-right: 60rpx;
	font-size: 28rpx;
	color: #888;
	border-bottom: 4rpx solid transparent;
	transition: all 0.2s;
}
.tab.active.data-v-5501f474 {
	color: #4f46e5;
	font-weight: 600;
	border-bottom-color: #4f46e5;
}
.tab-dot.data-v-5501f474 {
	width: 12rpx;
	height: 12rpx;
	background-color: #f56c6c;
	border-radius: 50%;
}

/* 列表区域 */
.list-area.data-v-5501f474 {
	flex: 1;
	padding: 24rpx 30rpx;
}

/* 纠纷卡片 */
.dispute-card.data-v-5501f474 {
	display: flex;
	background-color: #fff;
	border-radius: 20rpx;
	margin-bottom: 24rpx;
	overflow: hidden;
	box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
	transition: transform 0.15s;
}
.dispute-card.data-v-5501f474:active {
	transform: scale(0.98);
	opacity: 0.9;
}

/* 左侧状态条 */
.status-bar.data-v-5501f474 {
	width: 8rpx;
	flex-shrink: 0;
}
.bar-done.data-v-5501f474 {
	background: linear-gradient(to bottom, #52c41a, #73d13d);
}
.bar-pending.data-v-5501f474 {
	background: linear-gradient(to bottom, #fa8c16, #ffa940);
}

/* 卡片主体 */
.card-body.data-v-5501f474 {
	flex: 1;
	padding: 28rpx 28rpx 24rpx;
}

/* 卡片顶部：订单号 + 状态标签 */
.card-top.data-v-5501f474 {
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 20rpx;
}
.order-info.data-v-5501f474 {
	display: flex;
	align-items: center;
	gap: 12rpx;
}
.order-label.data-v-5501f474 {
	font-size: 22rpx;
	color: #fff;
	background-color: #4f46e5;
	padding: 4rpx 12rpx;
	border-radius: 6rpx;
	font-weight: 600;
}
.order-no.data-v-5501f474 {
	font-size: 28rpx;
	color: #333;
	font-weight: 600;
	letter-spacing: 1rpx;
}
.status-badge.data-v-5501f474 {
	font-size: 22rpx;
	padding: 6rpx 16rpx;
	border-radius: 30rpx;
	font-weight: 500;
}
.badge-done.data-v-5501f474 {
	background-color: #f6ffed;
	color: #52c41a;
	border: 1rpx solid #b7eb8f;
}
.badge-pending.data-v-5501f474 {
	background-color: #fff7e6;
	color: #fa8c16;
	border: 1rpx solid #ffd591;
}

/* 卡片中部：信息行 */
.card-middle.data-v-5501f474 {
	background-color: #fafafa;
	border-radius: 12rpx;
	padding: 18rpx 20rpx;
	margin-bottom: 20rpx;
}
.info-line.data-v-5501f474 {
	display: flex;
	align-items: center;
	margin-bottom: 12rpx;
}
.info-line.data-v-5501f474:last-child {
	margin-bottom: 0;
}
.line-label.data-v-5501f474 {
	font-size: 24rpx;
	color: #999;
	width: 140rpx;
	flex-shrink: 0;
}
.line-value.data-v-5501f474 {
	font-size: 26rpx;
	color: #555;
}
.line-value.result.has-result.data-v-5501f474 {
	color: #d46b08;
	font-weight: 600;
}
.line-value.result.no-result.data-v-5501f474 {
	color: #bfbfbf;
	font-style: italic;
}

/* 卡片底部：时间 + 操作 */
.card-bottom.data-v-5501f474 {
	display: flex;
	justify-content: space-between;
	align-items: center;
}
.time-text.data-v-5501f474 {
	font-size: 22rpx;
	color: #bbb;
}
.action-row.data-v-5501f474 {
	display: flex;
	align-items: center;
	gap: 4rpx;
}
.action-text.data-v-5501f474 {
	font-size: 24rpx;
	color: #4f46e5;
}
.action-arrow.data-v-5501f474 {
	font-size: 28rpx;
	color: #4f46e5;
	line-height: 1;
}

/* 加载/无更多 */
.loading-wrap.data-v-5501f474 {
	text-align: center;
	padding: 30rpx;
}
.loading-text.data-v-5501f474 {
	font-size: 24rpx;
	color: #bbb;
}
.no-more.data-v-5501f474 {
	text-align: center;
	padding: 20rpx 0 40rpx;
}
.no-more text.data-v-5501f474 {
	font-size: 24rpx;
	color: #ccc;
}

/* 空状态 */
.empty-wrap.data-v-5501f474 {
	display: flex;
	flex-direction: column;
	align-items: center;
	padding-top: 160rpx;
}
.empty-icon-wrap.data-v-5501f474 {
	width: 160rpx;
	height: 160rpx;
	background: linear-gradient(135deg, #f0f0ff, #e8e8ff);
	border-radius: 50%;
	display: flex;
	align-items: center;
	justify-content: center;
	margin-bottom: 32rpx;
}
.empty-icon.data-v-5501f474 {
	font-size: 80rpx;
}
.empty-title.data-v-5501f474 {
	font-size: 32rpx;
	color: #444;
	font-weight: 600;
	margin-bottom: 12rpx;
}
