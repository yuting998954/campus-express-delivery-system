<view class="container data-v-29badeee"><view class="status-section data-v-29badeee"><view class="status-text data-v-29badeee">{{a}}</view><view class="status-desc data-v-29badeee">{{b}}</view></view><view class="info-card data-v-29badeee"><view class="card-title data-v-29badeee">订单信息</view><view class="info-row data-v-29badeee"><text class="label data-v-29badeee">订单编号</text><text class="value data-v-29badeee">{{c}}</text></view><view class="info-row data-v-29badeee"><text class="label data-v-29badeee">取件码/单号</text><text class="value data-v-29badeee">{{d}}</text></view><view class="info-row data-v-29badeee"><text class="label data-v-29badeee">包裹数量</text><text class="value data-v-29badeee">{{e}}</text></view><view class="info-row data-v-29badeee"><text class="label data-v-29badeee">包裹属性</text><text class="value data-v-29badeee">{{f}}</text></view><view class="info-row data-v-29badeee"><text class="label data-v-29badeee">收件地址</text><text class="value data-v-29badeee">{{g}}</text></view><view class="info-row data-v-29badeee"><text class="label data-v-29badeee">期望时间</text><text class="value data-v-29badeee">{{h}}</text></view><view class="info-row data-v-29badeee"><text class="label data-v-29badeee">特殊备注</text><text class="value data-v-29badeee">{{i}}</text></view></view><view class="info-card data-v-29badeee"><view class="card-title data-v-29badeee">费用明细</view><view class="info-row data-v-29badeee"><text class="label data-v-29badeee">代取报酬</text><text class="value data-v-29badeee">￥{{j}}</text></view><view wx:if="{{k}}" class="info-row data-v-29badeee"><text class="label data-v-29badeee">加急费用</text><text class="value data-v-29badeee">￥{{l}}</text></view><view class="info-row total data-v-29badeee"><text class="label data-v-29badeee">合计</text><text class="value data-v-29badeee">￥{{m}}</text></view></view><view wx:if="{{n}}" class="info-card data-v-29badeee"><view class="card-title data-v-29badeee">代取人信息</view><view class="runner-info data-v-29badeee"><image class="avatar data-v-29badeee" src="{{o}}" mode="aspectFill"></image><view class="name-box data-v-29badeee"><view class="name data-v-29badeee">{{p}}</view><view class="rating data-v-29badeee">评分: {{q}}</view></view><button class="chat-btn data-v-29badeee" size="mini" bindtap="{{r}}">联系他</button></view></view><view wx:if="{{s}}" class="info-card data-v-29badeee"><view class="card-title data-v-29badeee">凭证照片</view><view class="photo-list data-v-29badeee"><view wx:if="{{t}}" class="photo-item data-v-29badeee"><image class="data-v-29badeee" src="{{v}}" mode="aspectFill" bindtap="{{w}}"></image><text class="data-v-29badeee">取件凭证</text></view><view wx:if="{{x}}" class="photo-item data-v-29badeee"><image class="data-v-29badeee" src="{{y}}" mode="aspectFill" bindtap="{{z}}"></image><text class="data-v-29badeee">送达凭证</text></view></view></view><view class="bottom-bar data-v-29badeee"><button wx:if="{{A}}" class="bar-btn secondary data-v-29badeee" bindtap="{{B}}">取消订单</button><button wx:if="{{C}}" class="bar-btn primary data-v-29badeee" bindtap="{{D}}">确认收到并支付</button><button wx:if="{{E}}" class="bar-btn secondary data-v-29badeee" bindtap="{{F}}">申诉</button><button wx:if="{{G}}" class="bar-btn primary data-v-29badeee" bindtap="{{H}}">评价</button></view></view>