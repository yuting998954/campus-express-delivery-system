
.container.data-v-29badeee {
	padding-bottom: 120rpx;
	background-color: #f8f8f8;
	min-height: 100vh;
}
.status-section.data-v-29badeee {
	background-color: #007AFF;
	color: #fff;
	padding: 40rpx 30rpx;
}
.status-text.data-v-29badeee {
	font-size: 36rpx;
	font-weight: bold;
	margin-bottom: 10rpx;
}
.status-desc.data-v-29badeee {
	font-size: 24rpx;
	opacity: 0.8;
}
.info-card.data-v-29badeee {
	background-color: #fff;
	margin: 20rpx;
	padding: 30rpx;
	border-radius: 12rpx;
}
.card-title.data-v-29badeee {
	font-weight: bold;
	font-size: 30rpx;
	margin-bottom: 20rpx;
	border-left: 8rpx solid #007AFF;
	padding-left: 20rpx;
}
.info-row.data-v-29badeee {
	display: flex;
	justify-content: space-between;
	margin-bottom: 15rpx;
	font-size: 26rpx;
}
.label.data-v-29badeee {
	color: #8c8c8c;
}
.value.data-v-29badeee {
	color: #262626;
}
.total.data-v-29badeee {
	border-top: 1rpx solid #f0f0f0;
	padding-top: 20rpx;
	font-weight: bold;
	font-size: 30rpx;
}
.total .value.data-v-29badeee {
	color: #f5222d;
}
.runner-info.data-v-29badeee,
.publisher-info.data-v-29badeee {
	display: flex;
	align-items: center;
}
.avatar.data-v-29badeee {
	width: 80rpx;
	height: 80rpx;
	border-radius: 50%;
	background-color: #eee;
	margin-right: 20rpx;
}
.name-box.data-v-29badeee {
	flex: 1;
}
.name.data-v-29badeee {
	font-weight: bold;
	font-size: 28rpx;
}
.credit-score.data-v-29badeee {
	font-size: 22rpx;
	color: #52c41a;
}
.score-value.excellent.data-v-29badeee {
	color: #52c41a;
	font-weight: bold;
}
.score-value.good.data-v-29badeee {
	color: #1890ff;
}
.score-value.fair.data-v-29badeee {
	color: #faad14;
}
.score-value.poor.data-v-29badeee {
	color: #ff4d4f;
}
.phone.data-v-29badeee {
	font-size: 24rpx;
	color: #666;
	margin-top: 4rpx;
}
.photo-list.data-v-29badeee {
	display: flex;
	gap: 20rpx;
}
.photo-item.data-v-29badeee {
	display: flex;
	flex-direction: column;
	align-items: center;
	font-size: 22rpx;
	color: #999;
}
.photo-item image.data-v-29badeee {
	width: 150rpx;
	height: 150rpx;
	border-radius: 8rpx;
	margin-bottom: 10rpx;
}

/* 评价信息区域 */
.eval-info-card.data-v-29badeee {
	border-left: 8rpx solid #52c41a;
}
.eval-header.data-v-29badeee {
	display: flex;
	align-items: center;
	margin-bottom: 16rpx;
}
.eval-stars.data-v-29badeee {
	display: flex;
	gap: 4rpx;
}
.eval-star.data-v-29badeee {
	font-size: 36rpx;
	color: #ddd;
	margin-right: 4rpx;
}
.eval-star.active.data-v-29badeee {
	color: #ffc107;
}
.eval-label.data-v-29badeee {
	font-size: 26rpx;
	color: #ffc107;
	margin-left: 12rpx;
	font-weight: bold;
}
.eval-tags.data-v-29badeee {
	display: flex;
	flex-wrap: wrap;
	gap: 12rpx;
	margin-bottom: 16rpx;
}
.eval-tag.data-v-29badeee {
	padding: 6rpx 16rpx;
	background: #fff7e6;
	color: #fa8c16;
	border-radius: 20rpx;
	font-size: 22rpx;
}
.eval-content.data-v-29badeee {
	font-size: 26rpx;
	color: #333;
	line-height: 1.6;
	padding: 16rpx;
	background: #f9f9f9;
	border-radius: 8rpx;
	margin-bottom: 12rpx;
}
.eval-time.data-v-29badeee {
	font-size: 22rpx;
	color: #999;
	text-align: right;
}
.eval-empty.data-v-29badeee {
	text-align: center;
	color: #999;
	font-size: 26rpx;
	padding: 20rpx 0;
}

/* 进度上报面板 */
.progress-panel.data-v-29badeee {
	background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
	color: #fff;
}
.progress-panel .card-title.data-v-29badeee {
	color: #fff;
	border-left-color: #fff;
}
.progress-steps.data-v-29badeee {
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding: 30rpx 10rpx;
}
.step.data-v-29badeee {
	display: flex;
	flex-direction: column;
	align-items: center;
}
.step-dot.data-v-29badeee {
	width: 24rpx;
	height: 24rpx;
	border-radius: 50%;
	background-color: rgba(255, 255, 255, 0.3);
	margin-bottom: 10rpx;
}
.step.active .step-dot.data-v-29badeee {
	background-color: #fff;
}
.step.completed .step-dot.data-v-29badeee {
	background-color: #52c41a;
}
.step-label.data-v-29badeee {
	font-size: 22rpx;
	white-space: nowrap;
}
.step-line.data-v-29badeee {
	flex: 1;
	height: 4rpx;
	background-color: rgba(255, 255, 255, 0.3);
	margin: 0 10rpx;
	margin-bottom: 30rpx;
}
.step-line.active.data-v-29badeee {
	background-color: #52c41a;
}
.progress-actions.data-v-29badeee {
	margin-top: 20rpx;
}
.progress-btn.data-v-29badeee {
	width: 100%;
	background-color: #fff;
	color: #667eea;
	border-radius: 40rpx;
	font-weight: bold;
}
.progress-btn[disabled].data-v-29badeee {
	background-color: rgba(255, 255, 255, 0.5);
	color: #999;
}
.bottom-bar.data-v-29badeee {
	position: fixed;
	bottom: 0;
	left: 0;
	right: 0;
	height: 100rpx;
	background-color: #fff;
	display: flex;
	align-items: center;
	padding: 0 30rpx;
	box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
	padding-bottom: constant(safe-area-inset-bottom);
	padding-bottom: env(safe-area-inset-bottom);
}
.bar-btn.data-v-29badeee {
	flex: 1;
	height: 70rpx;
	line-height: 70rpx;
	margin: 0 10rpx;
	font-size: 26rpx;
}
.primary.data-v-29badeee {
	background-color: #007AFF;
	color: #fff;
}
.secondary.data-v-29badeee {
	background-color: #f5f5f5;
	color: #666;
}

/* 进度上报弹窗 */
.modal-mask.data-v-29badeee {
	position: fixed;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	background-color: rgba(0, 0, 0, 0.5);
	z-index: 999;
	display: flex;
	align-items: center;
	justify-content: center;
}
.modal-content.data-v-29badeee {
	width: 600rpx;
	background-color: #fff;
	border-radius: 24rpx;
	padding: 40rpx;
}
.modal-title.data-v-29badeee {
	font-size: 32rpx;
	font-weight: bold;
	text-align: center;
	margin-bottom: 30rpx;
}
.modal-body.data-v-29badeee {
	margin-bottom: 30rpx;
}
.upload-section.data-v-29badeee {
	display: flex;
	flex-direction: column;
}
.upload-label.data-v-29badeee {
	font-size: 26rpx;
	color: #666;
	margin-bottom: 15rpx;
}
.upload-box.data-v-29badeee {
	width: 200rpx;
	height: 200rpx;
	border: 2rpx dashed #ddd;
	border-radius: 12rpx;
	display: flex;
	align-items: center;
	justify-content: center;
}
.upload-placeholder.data-v-29badeee {
	display: flex;
	flex-direction: column;
	align-items: center;
}
.upload-icon.data-v-29badeee {
	font-size: 60rpx;
	color: #ccc;
}
.upload-text.data-v-29badeee {
	font-size: 24rpx;
	color: #999;
	margin-top: 10rpx;
}
.proof-preview.data-v-29badeee {
	width: 200rpx;
	height: 200rpx;
	border-radius: 12rpx;
}
.modal-actions.data-v-29badeee {
	display: flex;
	gap: 20rpx;
}
.modal-btn.data-v-29badeee {
	flex: 1;
	height: 80rpx;
	line-height: 80rpx;
	border-radius: 40rpx;
	font-size: 28rpx;
}
.modal-btn.cancel.data-v-29badeee {
	background-color: #f5f5f5;
	color: #666;
}
.modal-btn.confirm.data-v-29badeee {
	background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
	color: #fff;
}
